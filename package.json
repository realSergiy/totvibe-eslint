{
  "name": "zyplux",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "knip": "knip",
    "format": "prettier --write --cache --log-level warn .",
    "typecheck": "tsc -b",
    "lint": "eslint . --cache",
    "lint:fix": "pnpm run lint --fix",
    "test": "vitest run",
    "upgrade": "npm-check-updates --root --workspaces --format group",
    "cz": "node apps/cz/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@zyplux/eslint-config": "workspace:*",
    "@zyplux/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "knip": "catalog:",
    "npm-check-updates": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
