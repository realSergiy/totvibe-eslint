{
  "name": "@zyplux/cz",
  "version": "0.7.0",
  "description": "Repo automation CLI: cut releases, push branches and PRs, and clone reference repos.",
  "keywords": [
    "cli",
    "release",
    "monorepo",
    "automation",
    "github"
  ],
  "license": "MIT",
  "author": "Sergiy Yeskov <sergiy.yeskov@gmail.com>",
  "homepage": "https://github.com/zyplux/zyplux/tree/main/apps/cz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyplux/zyplux.git",
    "directory": "apps/cz"
  },
  "type": "module",
  "bin": {
    "cz": "./src/index.ts"
  },
  "exports": {
    ".": "./src/cli.ts",
    "./contracts": "./src/contracts.ts",
    "./package.json": "./package.json"
  },
  "imports": {
    "#deps-catalog": "./src/deps-catalog.ts",
    "#optique": "./src/optique.ts",
    "#package.json": "./package.json",
    "#release-targets": "./src/release-targets.ts"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "imports": {
      "#deps-catalog": "./dist/src/deps-catalog.js",
      "#optique": "./dist/src/optique.js",
      "#package.json": "./package.json",
      "#release-targets": "./dist/src/release-targets.js"
    },
    "bin": {
      "cz": "./dist/src/index.js"
    },
    "exports": {
      ".": {
        "types": "./dist/src/cli.d.ts",
        "default": "./dist/src/cli.js"
      },
      "./contracts": {
        "types": "./dist/src/contracts.d.ts",
        "default": "./dist/src/contracts.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepack": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@optique/core": "catalog:",
    "@optique/run": "catalog:",
    "@zyplux/util": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zyplux/tsconfig": "workspace:*"
  }
}
