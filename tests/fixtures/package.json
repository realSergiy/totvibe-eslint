{
  "name": "@zyplux/tests-fixtures",
  "version": "0.5.0",
  "description": "Story-test fixtures for zyplux workspaces: Node exec fake, console capture, fetch routing, temp dirs, domain matchers, and vitest test.extend bases per app type",
  "keywords": [
    "test",
    "fixtures",
    "mock",
    "shell",
    "vitest"
  ],
  "license": "MIT",
  "author": "Sergiy Yeskov <sergiy.yeskov@gmail.com>",
  "homepage": "https://github.com/zyplux/zyplux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyplux/zyplux.git",
    "directory": "tests/fixtures"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepack": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "@zyplux/util": "workspace:*",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zyplux/tsconfig": "workspace:*",
    "@zyplux/util": "workspace:*",
    "vitest": "catalog:"
  }
}
